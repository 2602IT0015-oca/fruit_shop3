<ul>
  <li><%= link_to "トップページ", root_path %></li>
  <li><%= link_to "商品一覧", products_path %></li>
  <% if user_signed_in? %>
    <li><%= link_to "注文履歴", orders_path %></li>
    <li><%= link_to "マイページ", mypage_path(current_user) %></li>
    <li><%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %></li>
    <% unless current_user.admin_flg? %>
      <li><%= link_to "ユーザーカート", cart_path(current_user.cart) %></li>
    <% end %>
  <% else %>
    <li><%= link_to "サインアップ", new_user_registration_path %></li>
    <li><%= link_to "ログイン", new_user_session_path %></li>
    <li><%= link_to "セッションカート", carts_path %></li>
  <% end %>
</ul>